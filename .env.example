# Copy this file to .env and fill in real values.
# Never commit .env.

ACC_BASE_URL=https://acc.autodesk.com
ACC_PROJECT_ID=xxxx
ACC_FOLDER_NAME=Name-standard
# Option 1: leave these empty and pass the username to ./run.sh or .\run.ps1.
# Option 2 (encrypted credentials.json): leave these empty and set ACC_FERNET_KEY locally.
ACC_USERNAME=
ACC_PASSWORD=
# Option 2 only. Never commit this key. Public clones do not include it.
ACC_FERNET_KEY=
BROWSER=chromium
HEADLESS=true
TIMEOUT_MS=30000
# false = reuse auth_state.json (no login page). true = always open LoginPage.
ACC_SHOW_LOGIN=false
