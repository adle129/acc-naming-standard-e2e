# Copy this file to .env and fill in real values.
# Never commit .env.

ACC_BASE_URL=https://acc.autodesk.com
ACC_PROJECT_ID=xxxx
ACC_FOLDER_NAME=Name-standard
ACC_USERNAME=
ACC_PASSWORD=
# Fernet key for config/credentials.json. Not committed — send it to the reviewer separately.
ACC_FERNET_KEY=
BROWSER=chromium
HEADLESS=true
TIMEOUT_MS=30000
# false = reuse auth_state.json (no login page). true = always open LoginPage.
ACC_SHOW_LOGIN=false
