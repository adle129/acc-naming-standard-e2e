# Copy this file to .env and fill in real values.
# Never commit .env.

ACC_BASE_URL=https://acc.autodesk.com
ACC_PROJECT_ID=4ac3aedc-e6d5-4bbb-91f3-c49c48af48f4
ACC_FOLDER_NAME=Name-standard
# Option 1: leave these empty and pass the username to ./run.sh or .\run.ps1.
# Option 2 (homework account): leave these empty and set ACC_FERNET_KEY.
ACC_USERNAME=
ACC_PASSWORD=
# Option 2 only. Not committed — send it to the reviewer separately.
ACC_FERNET_KEY=
BROWSER=chromium
HEADLESS=true
TIMEOUT_MS=30000
# false = reuse auth_state.json (no login page). true = always open LoginPage.
ACC_SHOW_LOGIN=false
